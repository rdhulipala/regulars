# Free tier: https://neon.tech or https://supabase.com both give you this in ~2 minutes.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Used in the "week published" SMS text. Set to your deployed URL in production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional — omit all three and SMS just logs to the console (fine for the demo).
# Get these from https://console.twilio.com after creating a free trial account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
